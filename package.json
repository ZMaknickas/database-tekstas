{
  "name": "reactstart",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel client:dev server:dev",
    "client:dev": "npm --prefix ./client run dev",
    "server:dev": "npm --prefix ./server run dev",

    "build": "npm install --prefix ./client && npm install --prefix ./server && npm run build --prefix ./client",

    "start": "npm run start --prefix ./server"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}